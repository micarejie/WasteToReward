@page "/login"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>EcoReward | Sign In</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 py-10 bg-slate-50">
    <div class="w-full max-w-md bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <div class="flex flex-col items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mb-2">
                <IconRecycle Class="w-6 h-6 text-green-600" />
            </div>
            <h1 class="text-xl font-bold text-slate-900">EcoReward</h1>
            <p class="text-xs text-slate-500">Sign in to continue</p>
        </div>

        <EditForm Model="model" OnValidSubmit="Submit" class="space-y-3">
            <DataAnnotationsValidator />

            <div>
                <label class="block text-xs font-bold mb-1 text-slate-900">Email</label>
                <InputText @bind-Value="model.Email"
                           type="email"
                           placeholder="Enter your email"
                           class="w-full px-3 py-2 text-sm rounded-lg border border-slate-200 focus:ring-2 focus:ring-green-500 outline-none" />
                <ValidationMessage For="() => model.Email" class="text-xs text-red-500" />
            </div>

            <div>
                <label class="block text-xs font-bold mb-1 text-slate-900">Password</label>
                <InputText @bind-Value="model.Password"
                           type="password"
                           placeholder="Enter your password"
                           class="w-full px-3 py-2 text-sm rounded-lg border border-slate-200 focus:ring-2 focus:ring-green-500 outline-none" />
                <ValidationMessage For="() => model.Password" class="text-xs text-red-500" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="text-xs text-red-600">@errorMessage</p>
            }

            <button type="submit"
                    class="w-full bg-green-600 text-white py-2.5 rounded-lg font-bold hover:bg-green-700 transition"
                    disabled="@busy">
                @(busy ? "Signing in..." : "Sign In")
            </button>
        </EditForm>

        <p class="text-xs text-center text-slate-500 mt-4">
            <a href="/" class="text-green-600 font-semibold">Back to home</a>
        </p>
    </div>
</div>

@code {
    private readonly LoginModel model = new();
    private bool busy;
    private string? errorMessage;

    private async Task Submit()
    {
        busy = true;
        errorMessage = null;

        try
        {
            // TODO: replace with your real auth call.
            await Task.Delay(200);
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(6)]
        public string Password { get; set; } = string.Empty;
    }
}
