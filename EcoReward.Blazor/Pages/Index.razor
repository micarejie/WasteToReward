@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>EcoReward | Home</PageTitle>

<div id="nav-overlay" class="@(menuOpen ? "active" : null)" @onclick="CloseMenu"></div>

<nav>
    <a href="/" class="logo" @onclick="CloseMenu">
        <div class="logo-icon">
            <IconRecycle Class="w-6 h-6 text-green-600" />
        </div>
        EcoReward
    </a>

    <ul class="nav-links @(menuOpen ? "active" : null)" id="navMenu">
        <li><a href="/" @onclick="CloseMenu">Home</a></li>
        <li><a href="/about" @onclick="CloseMenu">About</a></li>
        <li><a href="/rewards" @onclick="CloseMenu">Rewards</a></li>
        <li><a href="/contact" @onclick="CloseMenu">Contact</a></li>
        <li class="md:hidden mobile-auth">
            <button type="button" class="btn btn-login w-full border border-slate-100" @onclick="OpenLoginFromMenu">Sign In</button>
            <button type="button" class="btn btn-register w-full" @onclick="OpenRegisterFromMenu">Register</button>
        </li>
    </ul>

    <div class="auth-buttons">
        <button type="button" class="btn btn-login" @onclick="OpenLogin">Sign In</button>
        <button type="button" class="btn btn-register" @onclick="OpenRegister">Register</button>
    </div>

    <button type="button" class="mobile-toggle" @onclick="ToggleMenu" aria-label="Toggle menu">
        @if (menuOpen)
        {
            <IconX Class="w-8 h-8" />
        }
        else
        {
            <IconMenu Class="w-8 h-8" />
        }
    </button>
</nav>

<main class="max-w-7xl mx-auto px-4 py-8 space-y-12">
    <section class="relative bg-gradient-to-br from-green-50 to-blue-50 rounded-3xl overflow-hidden p-8 md:p-16 flex flex-col md:flex-row items-center gap-8 border border-green-100">
        <div class="flex-1 space-y-6 z-10">
            <h1 class="text-4xl md:text-6xl font-extrabold text-slate-800 leading-tight">
                Turn Your <span class="text-green-600">Waste</span> <br />Into <span class="text-green-600">Rewards!</span>
            </h1>
            <p class="text-lg text-slate-600">Recycle &amp; Earn Points for Great Rewards</p>
            <div class="flex gap-4">
                <button type="button" class="bg-green-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-green-700 transition shadow-lg" @onclick="OpenRegister">
                    Join Now
                </button>
                <a href="/learn-more" class="inline-block bg-white text-slate-700 px-8 py-3 rounded-xl font-bold border border-slate-200 hover:bg-slate-50 transition shadow-sm">
                    Learn More
                </a>
            </div>
        </div>
        <div class="flex-1 relative flex justify-center">
            <div class="relative w-full max-w-md">
                <img src="https://img.freepik.com/free-vector/recycling-concept-illustration_114360-9851.jpg"
                     alt="Recycling Illustration"
                     class="rounded-2xl w-full" />
            </div>
        </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
        <div class="flex items-center gap-4">
            <div class="bg-green-100 p-4 rounded-xl text-green-600">
                <IconTrash Class="w-8 h-8" />
            </div>
            <div>
                <h3 class="font-bold text-slate-800">Recycle Your Waste</h3>
                <p class="text-sm text-slate-500">Dispose of recyclables and earn points.</p>
            </div>
        </div>
        <div class="flex items-center gap-4 border-x-0 md:border-x border-slate-100 px-0 md:px-8">
            <div class="bg-green-100 p-4 rounded-xl text-green-600">
                <IconAward Class="w-8 h-8" />
            </div>
            <div>
                <h3 class="font-bold text-slate-800">Earn Points</h3>
                <p class="text-sm text-slate-500">Get points for every item you recycle.</p>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="bg-green-100 p-4 rounded-xl text-green-600">
                <IconGift Class="w-8 h-8" />
            </div>
            <div>
                <h3 class="font-bold text-slate-800">Get Rewards</h3>
                <p class="text-sm text-slate-500">Exchange points for exciting rewards.</p>
            </div>
        </div>
    </div>

    <section class="space-y-8">
        <div class="text-center">
            <h2 class="text-3xl font-bold text-slate-800">Your Rewards Await!</h2>
            <p class="text-slate-500">Redeem your points for amazing rewards.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
                <div class="h-48 bg-orange-50 rounded-xl mb-4 flex items-center justify-center">
                    <IconCreditCard Class="w-16 h-16 text-orange-400" />
                </div>
                <h4 class="font-bold text-center">Gift Cards</h4>
                <p class="text-sm text-slate-500 text-center">Shop with popular gift cards.</p>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
                <div class="h-48 bg-blue-50 rounded-xl mb-4 flex items-center justify-center">
                    <IconHeadphones Class="w-16 h-16 text-blue-400" />
                </div>
                <h4 class="font-bold text-center">Eco Gadgets</h4>
                <p class="text-sm text-slate-500 text-center">Sustainable products &amp; gadgets.</p>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
                <div class="h-48 bg-red-50 rounded-xl mb-4 flex items-center justify-center">
                    <div class="text-red-400 font-black text-4xl">20% OFF</div>
                </div>
                <h4 class="font-bold text-center">Discount Vouchers</h4>
                <p class="text-sm text-slate-500 text-center">Save on dining, shopping &amp; more.</p>
            </div>
        </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pb-12">
        <div class="bg-green-50 p-8 rounded-3xl border border-green-100 flex justify-between items-center">
            <div>
                <h3 class="text-xl font-bold text-slate-800">Track Your Progress</h3>
                <p class="text-slate-600 mb-4 text-sm">View your recycling stats and points.</p>
                <button type="button"
                        class="bg-green-700 text-white px-6 py-2 rounded-lg font-bold hover:bg-green-800 transition-colors"
                        @onclick="OpenLogin">
                    My Dashboard
                </button>
            </div>
            <IconBarChart Class="w-16 h-16 text-green-200" />
        </div>
        <div class="bg-slate-100 p-8 rounded-3xl border border-slate-200 flex justify-between items-center">
            <div>
                <h3 class="text-xl font-bold text-slate-800">Eco Tips &amp; News</h3>
                <p class="text-slate-600 mb-4 text-sm">Learn how to live greener.</p>
                <button type="button"
                        class="bg-slate-700 text-white px-6 py-2 rounded-lg font-bold hover:bg-slate-800 transition-colors"
                        @onclick="OpenEcoTips">
                    Read Tips
                </button>
            </div>
            <IconLeaf Class="w-16 h-16 text-slate-300" />
        </div>
    </div>
</main>

<footer class="bg-white border-t border-slate-100 py-6">
    <div class="max-w-7xl mx-auto px-4 flex justify-center gap-12 text-sm font-semibold text-slate-500 flex-wrap">
        <div class="flex items-center gap-2"><IconRecycle Class="w-4 h-4 text-green-500" /> Reduce Waste</div>
        <div class="flex items-center gap-2"><IconDollar Class="w-4 h-4 text-green-500" /> Earn Points</div>
        <div class="flex items-center gap-2"><IconGift Class="w-4 h-4 text-green-500" /> Get Rewards</div>
    </div>
</footer>

<LoginModal Visible="showLogin"
            OnClose="CloseLogin"
            OnSwitchToRegister="SwitchToRegister"
            OnSuccess="HandleLoginSuccess" />

<RegisterModal Visible="showRegister"
               OnClose="CloseRegister"
               OnSwitchToLogin="SwitchToLogin"
               OnSuccess="HandleRegisterSuccess" />

<EcoTipsModal Visible="showEcoTips" OnClose="CloseEcoTips" />

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-success">@toastMessage</div>
}

@code {
    private bool menuOpen;
    private bool showLogin;
    private bool showRegister;
    private bool showEcoTips;
    private string? toastMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Contains("registered", StringComparison.OrdinalIgnoreCase))
        {
            toastMessage = "Registration Successful! Please sign in to continue.";
            showLogin = true;
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private void OpenLogin()
    {
        showRegister = false;
        showLogin = true;
    }

    private void OpenRegister()
    {
        showLogin = false;
        showRegister = true;
    }

    private void OpenLoginFromMenu()
    {
        CloseMenu();
        OpenLogin();
    }

    private void OpenRegisterFromMenu()
    {
        CloseMenu();
        OpenRegister();
    }

    private void OpenEcoTips() => showEcoTips = true;

    private void CloseLogin() => showLogin = false;
    private void CloseRegister() => showRegister = false;
    private void CloseEcoTips() => showEcoTips = false;

    private void SwitchToRegister()
    {
        showLogin = false;
        showRegister = true;
    }

    private void SwitchToLogin()
    {
        showRegister = false;
        showLogin = true;
    }

    private void HandleLoginSuccess()
    {
        showLogin = false;
        // After auth succeeds, go to the protected dashboard.
        Navigation.NavigateTo("/dashboard");
    }

    private void HandleRegisterSuccess()
    {
        showRegister = false;
        toastMessage = "Registration Successful! Please sign in to continue.";
        showLogin = true;
    }
}
