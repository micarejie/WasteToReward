@if (Visible)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="flex flex-col items-center">
                <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mb-2">
                    <IconLeaf Class="w-6 h-6 text-green-600" />
                </div>
                <h1 class="text-xl font-bold text-slate-900">Eco Tips</h1>
                <p class="text-xs text-slate-500 mb-6">Simple ways to help the planet</p>
            </div>

            <div class="text-left space-y-4">
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <h4 class="text-xs font-bold text-green-700 uppercase mb-1">Proper Sorting</h4>
                    <p class="text-[13px] text-slate-600">Always rinse your plastic bottles before recycling to prevent contamination.</p>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <h4 class="text-xs font-bold text-green-700 uppercase mb-1">Reduce &amp; Reuse</h4>
                    <p class="text-[13px] text-slate-600">Switch to reusable bags and containers to minimize the amount of waste generated.</p>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <h4 class="text-xs font-bold text-green-700 uppercase mb-1">Energy Saving</h4>
                    <p class="text-[13px] text-slate-600">Unplug electronics when not in use to reduce phantom energy consumption.</p>
                </div>
            </div>

            <button type="button"
                    class="w-full mt-5 bg-green-600 text-white py-2.5 rounded-lg font-bold hover:bg-green-700 transition"
                    @onclick="Close">
                Got it!
            </button>

            <button type="button" class="modal-close" @onclick="Close" aria-label="Close">×</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close() => await OnClose.InvokeAsync();
}
