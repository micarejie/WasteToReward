    @if (ShowTips)
    {
        <div class="modal-backdrop" @onclick="HideEcoTips">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-green"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.25 12 13 13 12" /></svg>
                    </div>
                    <h1>Eco Tips</h1>
                    <p>Simple ways to help the planet</p>
                </div>
                <div class="tips-list">
                    <div class="tip">
                        <h4>Proper Sorting</h4>
                        <p>Always rinse your plastic bottles before recycling to prevent contamination.</p>
                    </div>
                    <div class="tip">
                        <h4>Reduce &amp; Reuse</h4>
                        <p>Switch to reusable bags and containers to minimize the amount of waste generated.</p>
                    </div>
                    <div class="tip">
                        <h4>Energy Saving</h4>
                        <p>Unplug electronics when not in use to reduce phantom energy consumption.</p>
                    </div>
                </div>
                <button type="button" class="cta-primary modal-confirm" @onclick="HideEcoTips">Got it!</button>
            </div>
        </div>
    }
</div>

@code {
    private bool MenuOpen { get; set; }
    private bool ShowTips { get; set; }

    private void ToggleMenu() => MenuOpen = !MenuOpen;

    private void CloseMenu() => MenuOpen = false;

    private void GoHome()
    {
        CloseMenu();
        Nav.NavigateTo("/", forceLoad: false);
    }

    private void GoLogin()
    {
        CloseMenu();
        Nav.NavigateTo("/login");
    }

    private void GoRegister()
    {
        CloseMenu();
        Nav.NavigateTo("/login");
    }

    private void ShowEcoTips() => ShowTips = true;

    private void HideEcoTips() => ShowTips = false;

    // Already signed-in users go to their dashboard; guests keep seeing this page.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                return;

            var role = user.FindFirst(ClaimTypes.Role)?.Value;
            if (role == "User")
                Nav.NavigateTo("/user-dashboard", replace: true);
            else if (role == "Admin")
                Nav.NavigateTo("/admin-dashboard", replace: true);
        }
        catch
        {
            // Stay on landing if auth state is unavailable
        }
    }

}
