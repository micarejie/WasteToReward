# Copy this file to `.env.local` and fill in the values from your Supabase project.
# Do not commit real keys. Do not prefix the service-role key with NEXT_PUBLIC_.

# Project URL, from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable or anon key. Use the name your project shows.
# Newer projects call this the publishable key. Either variable is accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by scripts/create-admin.mjs. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata, the sitemap, and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Used only by scripts/create-admin.mjs.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local preview runs automatically in `npm run dev` when Supabase is not configured.
# It is disabled in production unless you set both of the following.
# Use a password of at least 12 characters that is not the development default.
ALLOW_DEMO_MODE=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Set to true to turn the local preview off even in development.
DISABLE_DEMO_MODE=
